<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup is disabled: Auto Backup would upload imported books and reading history,
    which conflicts with Cloven's local-only design. Direct device-to-device transfer
    (cable / local migration when setting up a new phone) is allowed, so a library can move
    to a new device without passing through a cloud service.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
